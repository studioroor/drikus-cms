    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc -p .",
    "schema": "bun scripts/export-schema.ts"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.1",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "otpauth": "^9.5.2",
    "sharp": "0.35.5",
    "yaml": "2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2"
  }
}
