# Public address of the CMS (used for invite links and CSRF checks).
PUBLIC_URL=http://localhost:3000
PORT=3000
# Where the SQLite database and encryption key live. Mount a volume here.
DATA_DIR=./data
# Optional: 32-byte base64 key for encrypting secrets at rest.
# If unset, one is generated in DATA_DIR/secret.key on first start.
# SECRET_KEY=
# Set to true behind a reverse proxy (Synology, Fly.io, Caddy, Traefik) so
# rate limiting sees the real client IP.
TRUST_PROXY=false
# Superadmins must enable two-step verification before using the admin screens.
# Set to false to make 2FA optional for them.
REQUIRE_ADMIN_2FA=true
# Daily database snapshots in DATA_DIR/backups; how many to keep (0 = off).
BACKUP_KEEP=7
# BACKUP_DIR=./data/backups

# --- GitHub App (see README → "GitHub App setup") ---
# GITHUB_APP_ID=123456
# Private key: by default read from DATA_DIR/github-app.pem. Alternatively:
# GITHUB_APP_PRIVATE_KEY_FILE=/run/secrets/github-app.pem
# GITHUB_APP_PRIVATE_KEY=<PEM text or base64 of it>
# Optional; without it the CMS polls GitHub instead of receiving push events.
# GITHUB_WEBHOOK_SECRET=
# GITHUB_ORG=studioroor
